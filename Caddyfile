# HTTPS for the main domain and every shop subdomain.
#
# DNS at GoDaddy: A records for "@" and "*" pointing at this server. Caddy asks the web service
# before requesting a certificate for any hostname (on-demand TLS); it answers yes only for the
# main domain, www and published shops, so made-up subdomains never get a certificate.
# While testing, set ACME_CA to Let's Encrypt staging to stay clear of rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
(app) {
	@internal path /internal/*
	respond @internal 404

	reverse_proxy web:8080
}

http://72.167.150.242 {
	reverse_proxy web:8080 {
		header_up Host ourvillagecrafts.in
	}
}
