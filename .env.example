# Copy to .env on the server (never commit .env). docker-compose.yml passes each service
# only the variables it needs: the Claude key goes to the agent only, and the database and
# SMTP passwords go to the web service (and the database) only.

# ---- Domain and certificates (caddy, web) ---------------------------------
DOMAIN=ourvillagecrafts.in
ACME_EMAIL=you@example.com
# Uncomment while testing, to use Let's Encrypt staging (avoids rate limits):
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ---- Shared between web and agent ------------------------------------------
# Long random string, e.g. `openssl rand -hex 32`
INTERNAL_TOKEN=

# ---- Agent only --------------------------------------------------------------
ANTHROPIC_API_KEY=
# AGENT_MODE=auto        # auto | live | mock (mock = scripted answers, no Claude calls)

# ---- Database (web, db) ------------------------------------------------------
DB_PASSWORD=

# ---- Group and first admin (web; used on first start only) -------------------
GROUP_NAME=Our Village Crafts
GROUP_TAGLINE=Handmade by the women of our village
GROUP_DESCRIPTION=
GROUP_LOCATION=
ADMIN_EMAIL=you@example.com
# At least 10 characters. If empty, a random one is generated and printed in the web log once.
ADMIN_PASSWORD=
SEED_SAMPLE_SHOP=false

# ---- Group mailbox (web) -------------------------------------------------------
MAIL_FROM=hello@ourvillagecrafts.in
# Titan: smtp.titan.email:465 (if the login is rejected, try smtpout.secureserver.net)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USERNAME=hello@ourvillagecrafts.in
SMTP_PASSWORD=

# ---- Dashboard cost figure, INR (web) ----------------------------------------
COST_DOMAIN_YEAR=999
COST_EMAIL_MONTH=150
COST_HOSTING_MONTH=400
